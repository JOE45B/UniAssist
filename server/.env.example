# Copy to .env and fill in. Never commit .env.
PORT=5000
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/uniassist?retryWrites=true&w=majority
# Local MongoDB: mongodb://127.0.0.1:27017/uniassist
MONGO_URI=mongodb://127.0.0.1:27017/uniassist
# Frontend origin(s) allowed by CORS, comma separated
CLIENT_URL=http://localhost:5173
# Long random string used to sign login tokens (node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Timezone used for "today", overdue labels and past-date checks
APP_TIMEZONE=Asia/Manila
